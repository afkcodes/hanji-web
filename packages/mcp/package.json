{
  "name": "@hanji/mcp",
  "version": "0.1.0",
  "description": "MCP server for hanji: lets coding agents list, search and read hanji components, fetch examples, read tokens, validate themes, and search and fetch icons.",
  "keywords": [
    "ai",
    "design-system",
    "hanji",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "bin": {
    "hanji-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@hanji/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hanji/icons": "workspace:*",
    "@hanji/react": "workspace:*",
    "@hanji/tokens": "workspace:*",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
