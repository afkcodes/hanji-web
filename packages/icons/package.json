{
  "name": "@hanji/icons",
  "version": "0.1.0",
  "description": "hanji icons: 1,500+ icons in five styles (outline, solid, wash, duotone, duotone solid), reshaped from Solar by 480 Design with hanji's softened joins and rounder corners. Tree-shakable React components, raw SVGs and a searchable catalog.",
  "keywords": [
    "hanji",
    "icons",
    "react",
    "svg"
  ],
  "license": "MIT AND CC-BY-4.0",
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@hanji/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dynamic": {
      "@hanji/source": "./src/dynamic.tsx",
      "types": "./dist/dynamic.d.ts",
      "default": "./dist/dynamic.js"
    },
    "./adapter": {
      "@hanji/source": "./src/adapter.tsx",
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./catalog": {
      "@hanji/source": "./src/catalog.ts",
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./icons.json": "./dist/icons.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "tsdown && node scripts/emit.ts && publint --strict",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@iconify-json/solar": "1.2.15",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
