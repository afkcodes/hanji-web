{
  "name": "@hanji/tokens",
  "version": "0.1.0",
  "description": "hanji design tokens: papers, inks, density, motion. Typed theme API with a JSON Schema, and the CSS variables generated from it.",
  "keywords": [
    "css-variables",
    "design-tokens",
    "hanji",
    "theme"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@hanji/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "@hanji/source": "./src/schema.ts",
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./theme.schema.json": "./dist/theme.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/emit.ts && publint --strict",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "lightningcss": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
