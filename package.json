{
  "name": "hanji-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hanji/playground dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings",
    "lint:css": "node scripts/lint-css.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ai": "turbo run ai",
    "check": "pnpm fmt:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.32.1"
}
